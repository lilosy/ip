<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<AnchorPane prefHeight="600.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lily.ui.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane" hbarPolicy="NEVER" prefHeight="550.0" prefWidth="400.0" AnchorPane.bottomAnchor="50.0">
            <content><VBox fx:id="dialogContainer" prefWidth="385.0" /></content>
        </ScrollPane>
        <TextField fx:id="userInput" onAction="#handleUserInput" prefHeight="45.0" prefWidth="320.0" AnchorPane.bottomAnchor="5.0" AnchorPane.leftAnchor="5.0" />
        <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput" prefHeight="45.0" prefWidth="70.0" text="Send" AnchorPane.bottomAnchor="5.0" AnchorPane.rightAnchor="5.0" />
    </children>
</AnchorPane>
